<div
  id="home-splash"
  class="home-splash"
  role="button"
  aria-label="Enter site"
  lang="en"
>
  <canvas class="home-splash__canvas" aria-hidden="true"></canvas>
  <script>
    (function () {
      var root = document.getElementById('home-splash');
      if (!root) return;
      var c = root.querySelector('.home-splash__canvas');
      if (!c || !c.getContext) return;
      var w = window.innerWidth;
      var h = window.innerHeight;
      var d = Math.min(window.devicePixelRatio || 1, 2);
      c.width = Math.floor(w * d);
      c.height = Math.floor(h * d);
      c.style.width = w + 'px';
      c.style.height = h + 'px';
      var ctx = c.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(d, 0, 0, d, 0, 0);
      ctx.fillStyle = '#0f1b15';
      ctx.fillRect(0, 0, w, h);
    })();
  </script>
  <div class="home-splash__veil" aria-hidden="true"></div>
  <div class="home-splash__content">
    <h1 class="home-splash__name" aria-label="Kaisen Yang">
      <span class="home-splash__typewriter" aria-hidden="true">Kaisen Yang</span>
    </h1>
    <p
      class="home-splash__tagline"
      data-taglines='["Every mature structure is a minimum cut on the flow of information.","Generation is compression with a future tense: the model remembers enough structure to keep imagining.","To study AI is to study ourselves.","Chasing the right benchmark is the most important thing in AI, and perhaps in life."]'
    >
      Every mature structure is a minimum cut on the flow of information.
    </p>
    <script>
      (function () {
        var tagline = document.currentScript.previousElementSibling;
        if (!tagline) return;
        try {
          var taglines = JSON.parse(tagline.getAttribute('data-taglines') || '[]');
          if (taglines.length) {
            tagline.textContent = taglines[Math.floor(Math.random() * taglines.length)];
          }
        } catch (e) {}
      })();
    </script>
    <span class="home-splash__hint">Click to enter</span>
  </div>
</div>
<script defer src="{{ '/assets/js/home-splash.js' | relative_url | bust_file_cache }}"></script>
